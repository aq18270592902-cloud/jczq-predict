# 统一换行符，避免 Windows / macOS 协作出混合 CRLF
* text=auto eol=lf

# 网页与脚本
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.mjs    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.xml    text eol=lf
*.webmanifest text eol=lf

# Windows 专用脚本保持 CRLF，否则 PowerShell 5.1 解析会出问题
*.ps1    text eol=crlf
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.vbs    text eol=crlf

# Shell 脚本必须是 LF，否则 Linux 上 bash 报 "bad interpreter"
*.sh     text eol=lf

# 二进制
*.png    binary
*.jpg    binary
*.jpeg   binary
*.ico    binary
*.zip    binary
